# Change this before running the admin.
ADMIN_EMAIL=ahad@example.com
ADMIN_PASSWORD=change-this-long-password
SESSION_SECRET=replace-with-a-long-random-secret
# Public canonical site URL used by metadata, sitemap and robots.txt.
# Local development: http://localhost:3000
# Production example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO verification (paste tokens from Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Persistent article storage (Supabase free-tier Postgres).
# Leave both blank for local dev — the site falls back to data/articles.json.
# Set both in production (Vercel dashboard) — see README "Persistent storage" section.
# SUPABASE_URL must be the "Project URL" and SUPABASE_SERVICE_ROLE_KEY must be the
# SERVICE ROLE key (not the anon/public key) — this app writes from the server only,
# and the service key must never be prefixed with NEXT_PUBLIC_ or it will be shipped
# to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
